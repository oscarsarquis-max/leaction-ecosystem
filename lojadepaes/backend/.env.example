LOJADEPAES_ENV=local
LOJADEPAES_HTTP_HOST=127.0.0.1
LOJADEPAES_HTTP_PORT=5075
LOJADEPAES_DATABASE_URL=postgresql+psycopg://lojadepaes:lojadepaes_dev@127.0.0.1:5438/lojadepaes
LOJADEPAES_DB_CONNECT_TIMEOUT_SECONDS=3
LOJADEPAES_CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
LOJADEPAES_BAKERY_TIMEZONE=America/Sao_Paulo
LOJADEPAES_TEST_DATABASE_URL=postgresql+psycopg://lojadepaes:lojadepaes_dev@127.0.0.1:5438/lojadepaes_test

# Gestão administrativa.
# Sem credencial real, /api/v1/admin fica desabilitada (503), salvo o modo local abaixo.
# Não coloque senha em texto. No backend, rode: python -m app.admin
# Os valores abaixo são ilustrativos e não funcionam como credencial.
# LOJADEPAES_ADMIN_USERNAME=definir-localmente
# LOJADEPAES_ADMIN_PASSWORD_HASH=argon2-gerado-localmente
# LOJADEPAES_ADMIN_SESSION_SECRET=gerar-localmente-com-pelo-menos-32-caracteres
# Acesso sem senha só em desenvolvimento local (desligado por padrão).
# Exige ENV local, API no loopback e esta flag. Não use em produção.
# LOJADEPAES_ADMIN_LOCAL_PASSWORDLESS=false
# LOJADEPAES_COOKIE_SECURE=false
# LOJADEPAES_SESSION_TTL_HOURS=8
# LOJADEPAES_LOGIN_MAX_FAILURES=5
# LOJADEPAES_LOGIN_WINDOW_MINUTES=15
# Fotos de produto (fora do Git e fora de frontend/images/). Persistente: incluir no backup.
# LOJADEPAES_MEDIA_DIR=../var/media
# LOJADEPAES_MEDIA_MAX_BYTES=8388608
# LOJADEPAES_MEDIA_BACKEND=local
# Produção: defina bucket e região reais no servidor. Sem esses valores o backend S3 não envia arquivo.
# LOJADEPAES_MEDIA_S3_BUCKET=
# LOJADEPAES_MEDIA_S3_REGION=
# LOJADEPAES_MEDIA_S3_PREFIX=lojadepaes-media
# Produção: defina bucket e região reais no servidor. Sem esses valores o backend S3 não envia arquivo.
# LOJADEPAES_MEDIA_S3_BUCKET=
# LOJADEPAES_MEDIA_S3_REGION=
# LOJADEPAES_MEDIA_S3_PREFIX=lojadepaes-media
# LOJADEPAES_MEDIA_S3_ENDPOINT_URL=
# LOJADEPAES_PREVIEW_PROTECTION=false
# LOJADEPAES_PUBLIC_ORDERS_ENABLED=true
# LOJADEPAES_PUBLIC_PAYMENTS_ENABLED=true
# LOJADEPAES_PUBLIC_DATE_REQUESTS_ENABLED=true
# Complementos (Prompt 73). Desligados até curadoria real e verificação isolada.
# LOJADEPAES_PUBLIC_ACCOMPANIMENTS_ENABLED=false
# LOJADEPAES_GIGIO_ACCOMPANIMENTS_ENABLED=false
# Base especializada do Gigio (Prompt 81). Desligada até revisão editorial das referências.
# LOJADEPAES_GIGIO_PAIRING_REFS_ENABLED=false
# Só local/dev: prévia com fixture identificada se o Hub não tiver item real.
# LOJADEPAES_ACCOMPANIMENTS_PREVIEW=false
# Plugin marketplace do ActionHub (local :4012). Vazio = não consulta. Timeout curto.
# LOJADEPAES_ACTIONHUB_MARKETPLACE_URL=http://127.0.0.1:4012/api/marketplace
# LOJADEPAES_ACTIONHUB_MARKETPLACE_TIMEOUT_SECONDS=2
# App id já é lojadepaes: o Hub mapeia para o perfil culinário. Sem este id a Loja não consulta o legado de TI.
# LOJADEPAES_SPA_DIR=
# LOJADEPAES_ACTIVATION_TTL_MINUTES=1440
# LOJADEPAES_ACTIVATION_RECIPIENT=oscar@oscarsarquis.com.br

# ActionHub local (valores reais ficam só no .env, fora do Git).
# LOJADEPAES_CRM_TRACKING_SECRET=
# LOJADEPAES_CRM_TRACKING_URL=http://127.0.0.1:4001/api/crm/tracking/receber
# LOJADEPAES_ACTIONHUB_APP_ID=lojadepaes
# LOJADEPAES_ACTIONHUB_APP_SECRET=
# LOJADEPAES_PUBLIC_ORIGIN=http://127.0.0.1:5175
# E-mail: Amazon SES na mesma conta/região do Hub (us-east-2).
# Remetente da Loja: loja@lojadepaes.com.br. Sem identidade SES verificada a outbox fica skipped.
# LOJADEPAES_MAIL_BACKEND=ses
# LOJADEPAES_SES_REGION=us-east-2
# LOJADEPAES_MAIL_FROM=loja@lojadepaes.com.br
# LOJADEPAES_MAIL_FROM_NAME=Loja de Pães
# LOJADEPAES_MAIL_IDENTITY_READY=false
# Destinatário operacional da padaria (aviso de novo pedido). Vazio = aviso skipped, sem envio real.
# Não use loja@ (remetente) nem admin@ (login). Não reutilize e-mail pessoal de teste SES sem autorização.
# LOJADEPAES_MAIL_OPS_TO=
# Gigio (Bedrock). Desligado por padrão. Credenciais só no servidor; não copie chave para o frontend.
# Contrato comprovado no Chamelleon: invoke_model + inference profile em us-east-1.
# LOJADEPAES_GIGIO_ENABLED=false
# LOJADEPAES_GIGIO_GATEWAY=fake
# LOJADEPAES_BEDROCK_REGION=us-east-1
# LOJADEPAES_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# LOJADEPAES_BEDROCK_MAX_TOKENS=1024
# LOJADEPAES_BEDROCK_TEMPERATURE=0.4
# LOJADEPAES_BEDROCK_SSL_VERIFY=true
# LOJADEPAES_BEDROCK_GUARDRAIL_ID=
# LOJADEPAES_BEDROCK_GUARDRAIL_VERSION=
# Credencial AWS: cadeia padrão (IAM da instância ou AWS_* no ambiente). Não coloque chave no frontend.
# SMTP legado, se algum dia existir host: LOJADEPAES_SMTP_HOST=


