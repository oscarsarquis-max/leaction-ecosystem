# Exemplo de variáveis no servidor. Copiar para /opt/lojadepaes/secrets/app.env
# Nunca versionar valores reais.

LOJADEPAES_ENV=production
LOJADEPAES_HTTP_HOST=0.0.0.0
LOJADEPAES_HTTP_PORT=8080
LOJADEPAES_DATABASE_URL=postgresql+psycopg://lojadepaes:CHANGE_ME@db:5432/lojadepaes
LOJADEPAES_CORS_ORIGINS=https://lojadepaes.com.br
LOJADEPAES_PUBLIC_ORIGIN=https://lojadepaes.com.br
LOJADEPAES_COOKIE_SECURE=true
LOJADEPAES_ADMIN_LOCAL_PASSWORDLESS=false
LOJADEPAES_ADMIN_USERNAME=admin@lojadepaes.com.br
LOJADEPAES_ADMIN_PASSWORD_HASH=
LOJADEPAES_ADMIN_SESSION_SECRET=gerar-localmente-com-pelo-menos-32-caracteres
LOJADEPAES_PREVIEW_PROTECTION=true
LOJADEPAES_PUBLIC_ORDERS_ENABLED=false
LOJADEPAES_PUBLIC_PAYMENTS_ENABLED=false
LOJADEPAES_PUBLIC_DATE_REQUESTS_ENABLED=false
LOJADEPAES_MEDIA_BACKEND=s3
LOJADEPAES_MEDIA_S3_BUCKET=lojadepaes-media-253137917703
LOJADEPAES_MEDIA_S3_REGION=us-east-2
LOJADEPAES_MEDIA_S3_PREFIX=lojadepaes-media
LOJADEPAES_AWS_ACCESS_KEY_ID=
LOJADEPAES_AWS_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
LOJADEPAES_MAIL_BACKEND=ses
LOJADEPAES_SES_REGION=us-east-2
LOJADEPAES_MAIL_FROM=loja@lojadepaes.com.br
LOJADEPAES_MAIL_FROM_NAME=Loja de Pães
LOJADEPAES_MAIL_IDENTITY_READY=true
LOJADEPAES_SPA_DIR=/app/frontend/dist
LOJADEPAES_ACTIONHUB_BASE_URL=
LOJADEPAES_ACTIONHUB_APP_SECRET=
LOJADEPAES_ACTIVATION_RECIPIENT=oscar@oscarsarquis.com.br
LOJADEPAES_ACTIVATION_TTL_MINUTES=1440
