# Panne — fundação local (sem credenciais)
# Copie este arquivo para .env (não versionado) e substitua os marcadores.
PANNE_ENV=local
PANNE_HTTP_HOST=127.0.0.1
PANNE_HTTP_PORT=5080
PANNE_VERSAO=0.1.0

# Postgres dedicado no container compartilhado leaction_db.
# Preencha com as credenciais locais do workspace (não grave senha neste arquivo).
# Porta host: conferir com `docker port leaction_db 5432` (nesta máquina costuma ser 5434).
PANNE_DATABASE_URL=postgresql+asyncpg://<configure-local-user>:<configure-local-password>@127.0.0.1:5434/panne
# Papel de runtime (sem superuser, sem BYPASSRLS, sem propriedade das tabelas).
PANNE_RUNTIME_DATABASE_URL=postgresql+asyncpg://<configure-runtime-user>:<configure-runtime-password>@127.0.0.1:5434/panne

# Autenticação OIDC / Cognito User Pools. Sem segredos neste arquivo.
PANNE_AUTH_VERIFIER=fake
# Token local explícito (mesmo valor do frontend). Proibido em produção.
PANNE_FAKE_ACCESS_TOKEN=
PANNE_FAKE_ISSUER=https://panne.local/fake
PANNE_FAKE_SUBJECT=local-dev-owner
PANNE_OIDC_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
PANNE_OIDC_CLIENT_ID=<configure-app-client-id>
PANNE_OIDC_AUDIENCE=
PANNE_OIDC_REQUIRED_SCOPE=
PANNE_JWKS_TIMEOUT_SECONDS=3
PANNE_MAX_AUTHORIZATION_HEADER_BYTES=8192

# Editorial /entrar — Action Hub (somente servidor; browser não vê estas URLs).
# PANNE_ENV=demo → config_key=panne-demo; prod → panne; override opcional abaixo.
PANNE_ACTION_HUB_API_URL=http://127.0.0.1:4001
PANNE_LOGIN_EDITORIAL_TIMEOUT_SECONDS=2.5
PANNE_LOGIN_EDITORIAL_CACHE_TTL_SECONDS=30
# Idade máxima do stale (s). Além disso → fallback estático. Cache = memória por processo.
PANNE_LOGIN_EDITORIAL_CACHE_MAX_STALE_SECONDS=600
PANNE_LOGIN_EDITORIAL_MAX_BYTES=200000
# Em produção, panne-demo via override é bloqueado salvo:
# PANNE_LOGIN_EDITORIAL_ALLOW_DEMO_KEY_IN_PROD=1
# PANNE_LOGIN_EDITORIAL_CONFIG_KEY=panne-demo
# CSV hosts HTTPS (vazio = defaults documentados em url_policy.py)
# PANNE_LOGIN_EDITORIAL_MEDIA_HOSTS=paneldx-cms-assets-2026.s3.amazonaws.com
# PANNE_LOGIN_EDITORIAL_CTA_HOSTS=docs.leaction.com.br,leaction.com.br

# Bedrock / Claude — sem access key neste arquivo.
# Credenciais vêm da cadeia padrão da AWS (perfil, IAM, temporárias ou .env local).
AWS_REGION=
BEDROCK_REGION=
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
