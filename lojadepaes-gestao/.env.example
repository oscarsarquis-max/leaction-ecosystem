# Exemplo para desenvolvimento local. Em produção o arquivo real fica só no servidor
# (/opt/lojadepaes-gestao/secrets/app.env, chmod 600) e nunca é versionado.
GESTAO_ENV=development
GESTAO_DATABASE_URL=postgresql+psycopg://gestao_app:CHANGE_ME@127.0.0.1:55440/gestao
GESTAO_LOJA_DATABASE_URL=postgresql+psycopg://gestao_reader:CHANGE_ME@127.0.0.1:55440/lojadepaes
GESTAO_SESSION_SECRET=gere-com-openssl-rand-hex-32
GESTAO_COOKIE_SECURE=false
GESTAO_BAKERY_TIMEZONE=America/Sao_Paulo
