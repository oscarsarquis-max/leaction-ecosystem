# SegSense local development — not secrets. Copy to `.env` before starting.

SEGSENSE_POSTGRES_PORT=5437
POSTGRES_DB=segsense
POSTGRES_USER=segsense
POSTGRES_PASSWORD=segsense_local_dev

SEGSENSE_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5437/segsense
SEGSENSE_DATASOURCE_USERNAME=segsense
SEGSENSE_DATASOURCE_PASSWORD=segsense_local_dev

SEGSENSE_BACKEND_PORT=8088
SPRING_PROFILES_ACTIVE=local
SEGSENSE_APPLICATION_ID=SEGSENSE
SEGSENSE_FRONTEND_ORIGIN=http://127.0.0.1:5178,http://localhost:5178
SEGSENSE_API_PUBLIC_URL=http://127.0.0.1:8088
SEGSENSE_PUBLIC_BASE_URL=http://127.0.0.1:5178

VITE_API_BASE_URL=http://127.0.0.1:8088
VITE_DEV_PORT=5178

# Segredos da fatia demo: NÃO coloque valores neste arquivo.
# Gere com: segsense/scripts/setup-mvp-demo-secrets.ps1
# Variáveis: SPIDER_SEGSENSE_DEMO_APPLICATION_SECRET,
# SEGSENSE_SPIDER_DEMO_APPLICATION_SECRET, SEGSENSE_MOCK_CREDENTIAL,
# SPIDER_SEGSENSE_MOCK_CREDENTIAL.

SEGSENSE_SPIDER_DEMO_BASE_URL=http://127.0.0.1:8080
SEGSENSE_SPIDER_DEMO_CREDENTIAL_REF=local-demo-segsense
