# Copie para .env.production (nunca commitar segredos)
INOVE4US_ENV=production
FLASK_ENV=production
SECRET_KEY=troque-por-segredo-longo-aleatorio

# Postgres compartilhado com PanelDX (LeAction_SysF) — host privado / RDS
DB_HOST=SEU_RDS_ENDPOINT.amazonaws.com
DB_PORT=5432
DB_NAME=LeAction_SysF
DB_USER=inove4us_app
DB_PASS=
DB_SSLMODE=require

FRONTEND_ORIGIN=https://inove4us.com.br
CORS_ORIGINS=https://inove4us.com.br,https://www.inove4us.com.br

# E-mail (SES)
EMAIL_DEV_MODE=0
EMAIL_SENDER=noreply@inove4us.com.br
AWS_REGION=us-east-1
# Preferir IAM role na task/serviço; chaves só se inevitável
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Bedrock (wizard + PEI 🧩). Não usar claude-sonnet-4-20250514 (legacy → 502).
BEDROCK_REGION=us-east-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
PEI_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_SSL_VERIFY=1

PORT=8080
WEB_CONCURRENCY=2

# Action Hub — JWT do outbox (igual a app_registry.webhook_secret no Hub)
ACTIONHUB_WEBHOOK_SECRET=
ACTION_HUB_APP_ID=inove4us
ACTION_HUB_API_URL=https://api.actionhub.com.br
