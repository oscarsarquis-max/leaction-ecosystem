# inove4us � Postgres local (Docker leaction_db), DB dedicado
# Bootstrap: infra/scripts/bootstrap-inove4us-db.ps1
# Credenciais iguais ao PanelDX; banco separado (n�o usa LeAction_SysF).

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=inove4us
DB_USER=admin
DB_PASS=Cmgv6190!@
DB_SSLMODE=disable

FLASK_PORT=5010

# Bedrock / wizard — SLA ~30s (Haiku + teto; sem retry por padrão)
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# WIZARD_BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
# WIZARD_TOTAL_BUDGET_SEC=30
# WIZARD_BEDROCK_READ_TIMEOUT=25
# WIZARD_RETRY_ENABLED=0
# BEDROCK_MAX_TOKENS=2048
# WIZARD_REF_LIMIT=2
SECRET_KEY=troque-esta-chave-em-producao
CORS_ORIGINS=http://localhost:5174
FRONTEND_ORIGIN=http://localhost:5174

# 1 = loga o código no servidor (local). 0 = envia via SES.
EMAIL_DEV_MODE=1
EMAIL_SENDER=noreply@inove4us.com.br
# Assets de e-mail (logo) — URL pública; não use localhost
EMAIL_ASSET_ORIGIN=https://inove4us.com.br
SES_REGION=us-east-2
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Action Hub � entitlements (mesmo valor de app_registry.webhook_secret)
ACTION_HUB_APP_ID=inove4us
ACTION_HUB_APP_SECRET=
ACTION_HUB_API_URL=http://localhost:4001
# Headless CMS — cache local de /api/noticias (segundos; padrão 480 = 8 min)
# CMS_CACHE_TTL_SEC=480
# CMS_HUB_TIMEOUT_SEC=3.5
# Secret JWT do outbox Action Hub (= app_registry.webhook_secret)
ACTIONHUB_WEBHOOK_SECRET=

# Integração S2S inove4us School → comunicados (mural/agenda)
# Header: X-School-Api-Key: <valor>
SCHOOL_INTEGRATION_API_KEY=

# Ponte S2S School ↔ B2C (JWT HS256 — mesmo secret do School)
SCHOOL_B2C_SHARED_SECRET=sk_test_internal_bridge_777
# Outbound B2C → School (LESSON_RECORD_SYNC / curadoria)
INOVE4US_SCHOOL_API_URL=http://127.0.0.1:5012
INOVE4US_SCHOOL_WEBHOOK_URL=http://127.0.0.1:5012/api/webhooks/b2c
# Action-Sponge (mesmo CRM_TRACKING_SECRET do leaction-platform)
CRM_TRACKING_SECRET=
ACTION_HUB_CRM_TRACKING_URL=http://127.0.0.1:4001/api/crm/tracking/receber
# SKU real do catalog_plans quando o FE manda o alias golive-50
ACTION_HUB_DEFAULT_SKU=
# Extrato no cartão (máx. 22 chars) — branding white-label da demandante
MP_STATEMENT_DESCRIPTOR=INOVE4US
FRONTEND_ORIGIN=http://localhost:5174


# Gatekeeper (mesmo padrao mudaedu/PanelDX)
# PRODUCTION_MASTER_KEY=
# GATEKEEPER_ALLOW_DEV=true
