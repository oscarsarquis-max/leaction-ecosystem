{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spider.leaction.local/contracts/satellite/1.5/satellite-interaction-request.schema.json",
  "title": "SatelliteInteractionRequestV1_5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "messageId",
    "correlationId",
    "satelliteId",
    "satelliteRole",
    "interactionType",
    "createdAt",
    "idempotencyKey",
    "purpose"
  ],
  "properties": {
    "contractVersion": { "type": "string", "const": "1.5" },
    "messageId": { "type": "string", "minLength": 8, "maxLength": 80 },
    "correlationId": { "type": "string", "minLength": 8, "maxLength": 80 },
    "satelliteId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "satelliteRole": { "type": "string", "enum": ["EXPERIENCE", "PROVIDER"] },
    "interactionType": {
      "type": "string",
      "enum": [
        "DECLARE_OBJECTIVE",
        "CONTINUE_CONTEXT",
        "REQUEST_DECISION",
        "QUERY_STATUS",
        "EXECUTE_CAPABILITY",
        "CAPABILITY_RESULT"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 80 },
    "purpose": {
      "type": "string",
      "enum": [
        "INSURANCE_PROTECTION_ASSESSMENT",
        "WORKING_CAPITAL_ASSESSMENT",
        "FINANCIAL_EXTERNAL_LOOKUP",
        "FINANCIAL_EXTERNAL_LIST",
        "LOJA_BIBLIOTECA"
      ]
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "origin", "declaredAt"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 120 },
        "origin": { "type": "string", "enum": ["SATELLITE_GOVERNED", "USER_DECLARED"] },
        "declaredAt": { "type": "string", "format": "date-time" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contextRef": { "type": "string", "pattern": "^ctx-[a-zA-Z0-9-]{8,80}$" },
        "snapshot": { "$ref": "#/$defs/contextSnapshot" }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "dataClassification": {
      "type": "string",
      "enum": ["PUBLIC", "INTERNAL", "PERSONAL", "SENSITIVE_BUSINESS", "RESTRICTED"]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 80 }
    },
    "responseChannel": { "type": "string", "enum": ["SYNC"] },
    "metadata": {
      "type": "object",
      "maxProperties": 8,
      "additionalProperties": { "type": "string", "maxLength": 200 }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customerAssertion": { "type": "string", "minLength": 16, "maxLength": 400 },
        "workingCapitalParameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "principalCents": { "type": "integer", "minimum": 10000, "maximum": 100000000 },
            "termMonths": { "type": "integer", "minimum": 1, "maximum": 36 },
            "origin": { "const": "USER_DECLARED" }
          }
        },
        "financialLookup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["companyId", "externalReference", "originSystem"],
          "properties": {
            "companyId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "externalReference": { "type": "string", "minLength": 4, "maxLength": 80 },
            "originSystem": { "type": "string", "const": "ACTIONHUB_PAY" },
            "titleId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          }
        },
        "financialList": {
          "type": "object",
          "additionalProperties": false,
          "required": ["companyId", "originSystem", "environment"],
          "properties": {
            "companyId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "originSystem": { "type": "string", "const": "ACTIONHUB_PAY" },
            "environment": { "type": "string", "enum": ["HOMOLOG", "SANDBOX", "PRODUCTION"] },
            "cursor": { "type": "string", "minLength": 8, "maxLength": 400 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
          }
        },
        "biblioteca": {
          "type": "object",
          "additionalProperties": false,
          "required": ["appId"],
          "properties": {
            "appId": { "type": "string", "const": "lojadepaes" },
            "subjectId": { "type": "string", "minLength": 3, "maxLength": 180 },
            "sku": { "type": "string", "minLength": 4, "maxLength": 80 },
            "operationId": { "type": "string", "minLength": 8, "maxLength": 80 },
            "amount": { "type": "integer", "minimum": 1, "maximum": 100 },
            "returnOrigin": { "type": "string", "minLength": 8, "maxLength": 200 },
            "returnTo": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "sourceId", "sourceTimestamp", "captureMethod", "trustLevel"],
      "properties": {
        "sourceType": {
          "type": "string",
          "enum": [
            "USER_DECLARED",
            "SATELLITE_GOVERNED",
            "URL_EXTRACTED",
            "PAGE_CONTEXT",
            "SYSTEM_EVENT",
            "DIRECT_ENTRY"
          ]
        },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sourceTimestamp": { "type": "string", "format": "date-time" },
        "captureMethod": {
          "type": "string",
          "enum": ["SERVER_REGISTRY", "SATELLITE_DECLARED", "SERVER_FETCH"]
        },
        "trustLevel": { "type": "string", "enum": ["GOVERNED", "DECLARED", "OBSERVED", "UNVERIFIED"] }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "sourceType",
        "sourceId",
        "sourceTimestamp",
        "captureMethod",
        "trustLevel",
        "used",
        "elements"
      ],
      "properties": {
        "role": { "type": "string", "enum": ["GOVERNED_SOURCE", "VISITOR_DECLARED", "URL_EXTRACTED"] },
        "sourceType": { "type": "string", "enum": ["SATELLITE_GOVERNED", "USER_DECLARED", "URL_EXTRACTED"] },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sourceTimestamp": { "type": "string", "format": "date-time" },
        "captureMethod": {
          "type": "string",
          "enum": ["SERVER_REGISTRY", "SATELLITE_DECLARED", "SERVER_FETCH"]
        },
        "trustLevel": { "type": "string", "enum": ["GOVERNED", "DECLARED", "OBSERVED"] },
        "used": { "type": "boolean" },
        "elements": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "contextSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "classification", "nonPersonal", "provenance", "contributions"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "1.5" },
        "classification": {
          "type": "string",
          "enum": ["PUBLIC", "INTERNAL", "PERSONAL", "SENSITIVE_BUSINESS", "RESTRICTED"]
        },
        "nonPersonal": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "selectedContribution": {
          "type": "string",
          "enum": ["GOVERNED_SOURCE", "VISITOR_DECLARED", "URL_EXTRACTED", "BOTH"]
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/contribution" }
        },
        "attributes": {
          "type": "object",
          "maxProperties": 12,
          "additionalProperties": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
