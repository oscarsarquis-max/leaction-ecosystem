{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spider.leaction.local/contracts/satellite/1.0/provider-execution-result.schema.json",
  "title": "ProviderExecutionResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "correlationId",
    "capabilityId",
    "providerId",
    "status",
    "executedAt"
  ],
  "properties": {
    "requestId": { "type": "string", "minLength": 8, "maxLength": 80 },
    "correlationId": { "type": "string", "minLength": 8, "maxLength": 80 },
    "capabilityId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "providerId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "status": { "type": "string", "enum": ["ACCEPTED", "COMPLETED", "REJECTED", "FAILED", "PENDING"] },
    "result": { "type": ["object", "null"] },
    "reasonCodes": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 80 }
    },
    "executedAt": { "type": "string", "format": "date-time" },
    "providerReference": { "type": ["string", "null"], "maxLength": 80 }
  }
}
