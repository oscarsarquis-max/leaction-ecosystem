{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spider://context/intent-contract/1.0",
  "title": "Spider Intent Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intent",
    "domain",
    "objective",
    "entities",
    "constraints",
    "provenance",
    "confidence"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "intent": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationAllowed", "readOnly", "confirmationRequired"],
      "properties": {
        "mutationAllowed": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "confirmationRequired": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "enum": [
            "BUSINESS_CARD",
            "FORM",
            "API",
            "NATURAL_LANGUAGE",
            "EXTERNAL_PLATFORM",
            "SERVICENOW"
          ]
        },
        "sourceRef": { "type": ["string", "null"] }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
