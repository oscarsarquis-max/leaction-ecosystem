# inove4us School (B2B) — template local
FLASK_ENV=development
FLASK_PORT=5012
SECRET_KEY=change-me-school-dev

# Banco dedicado (NÃO use o DB do inove4us B2C)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=inove4us_school
DB_USER=admin
DB_PASS=password123
DB_SSLMODE=prefer

# CORS / FE
CORS_ORIGINS=http://localhost:5175
FRONTEND_ORIGIN=http://localhost:5175

# Seed dev instituição (migration 005) — interino até auth real
DEV_INSTITUICAO_ID=a1111111-1111-4111-8111-111111111111

# Action Hub — Micro-CMS das colunas /acesso + Outbox S2S
ACTION_HUB_API_URL=http://127.0.0.1:4001
ACTIONHUB_WEBHOOK_SECRET=sk_test_school_webhook_secret_999
# Alias opcional (mesmo valor):
# ACTION_HUB_APP_SECRET=sk_test_school_webhook_secret_999
CMS_CACHE_TTL_SEC=480
CMS_HUB_TIMEOUT_SEC=3.5

# Auth (opcional em dev): senha mestra se o hash do gestor ainda não for werkzeug
# AUTH_DEV_PASSWORD=

# Ponte S2S School ↔ B2C (JWT HS256 — isolamento total de DB)
SCHOOL_B2C_SHARED_SECRET=sk_test_internal_bridge_777
INOVE4US_B2C_API_URL=http://127.0.0.1:5010
INOVE4US_B2C_WEBHOOK_URL=http://127.0.0.1:5010/api/webhooks/school
