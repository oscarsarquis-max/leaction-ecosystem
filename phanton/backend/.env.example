# Provedor LLM plugável (Fase A — fundação)
# google = Gemini (default) | ollama = IA local via Ollama
LLM_PROVIDER=google
# Com Google: use um modelo Gemini (não coloque tag Ollama aqui)
LLM_MODEL=gemini-3.5-flash
# Usado quando LLM_PROVIDER=ollama (ex.: http://127.0.0.1:11434)
LLM_BASE_URL=
# Modelo Ollama (só com LLM_PROVIDER=ollama). Ex.: qwen2.5-coder:3b
OLLAMA_MODEL=

# Compat Google (aliases ainda aceitos pelo factory/provider)
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash

# Context7 — memoria organizacional (PRDs/SDDs)
# mock = Gemini-inventor (default da fase quando provider=mock)
# http = API REST generica
# git  = repo Markdown local + ChromaDB
# pgvector = stub (ainda nao implementado)
CONTEXT7_PROVIDER=mock
CONTEXT7_API_URL=
CONTEXT7_API_KEY=
CONTEXT7_DB_DSN=
CONTEXT7_TOP_K=2
CONTEXT7_MIN_SCORE=

# Provider git + Chroma (CONTEXT7_PROVIDER=git)
CONTEXT7_GIT_REPO_PATH=
CONTEXT7_GIT_DOCS_GLOB=**/*.md
CONTEXT7_INDEX_DIR=
# default: sentence-transformers/all-MiniLM-L6-v2
# use "hash" apenas em testes unitarios rapidos (nao usar em producao)
CONTEXT7_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Linear — exportação de Epics/Issues (fase task_breakdown)
# Personal API Key: https://linear.app/settings/account/security
LINEAR_API_KEY=
# UUID do time (Team → Settings → ou GraphQL query { teams { nodes { id name } } })
LINEAR_TEAM_ID=

# Auth aditivo (login / JWT). Sem Authorization = admin local (fluxo atual).
# Gere um segredo forte em produ��o. Criar usu�rios:
#   python scripts/create_user.py --username andrea --password '***' --role restricted_tester
#   python scripts/create_user.py --username oscar --password '***' --role admin
PHANTON_JWT_SECRET=
PHANTON_JWT_TTL_HOURS=12

# Cat?logo de identidade no Action Hub (S2S ? login continua local)
ACTION_HUB_API_URL=http://localhost:4001
PHANTON_HUB_APP_SECRET=
