# Copie para .env (nunca commitar .env real)
DATABASE_URL="postgresql://leactiona:leactiona_dev@127.0.0.1:5436/leactiona?schema=public"

# 32 bytes em base64 — gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=

# Em produção: RDS com Encryption at Rest via AWS KMS (infra). App-level AES-GCM cobre PII (LGPD art. 46).
# AWS_KMS_KEY_ID=
# NODE_ENV=production

# JWT RS256 — em prod use PEM via env; em dev gera `.keys/` automaticamente
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
JWT_ISSUER=https://leactiona.com.br
JWT_AUDIENCE=leactiona-api
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_MAX=120

# Origens do FE (CloudFront / Next). Obrigatório em production (vírgula-separado).
# CORS_ALLOWED_ORIGINS=https://leactiona.com.br,https://www.leactiona.com.br
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3020,http://localhost:3020

# Mídia — CloudFront signed URLs (prod) ou HMAC local (dev)
SIGNED_URL_MODE=local
MEDIA_URL_TTL_SEC=300
MEDIA_CDN_BASE_URL=https://cdn.leactiona.local
# MEDIA_SIGNING_SECRET=
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_DISTRIBUTION_DOMAIN=
# CLOUDFRONT_PRIVATE_KEY_PEM=

# Learning Locker (LRS externo) — HTTPS + Basic Auth
# LRS_ENDPOINT=https://lrs.example.com
# LRS_KEY=
# LRS_SECRET=
# LRS_WEBHOOK_SECRET=
# LRS_MOCK=1
