{
  "name": "leactiona",
  "version": "0.1.0",
  "private": true,
  "description": "LEACTIONA.COM.BR — LMS multimídia single-tenant",
  "type": "module",
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "start": "node --import tsx backend/src/server.ts",
    "db:up": "docker compose -f database/docker-compose.yml up -d",
    "db:down": "docker compose -f database/docker-compose.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "tsx --test tests/**/*.test.ts",
    "test:db": "tsx --test tests/database-core.test.ts",
    "test:auth": "tsx --test tests/auth-rbac.test.ts",
    "test:lms": "tsx --test tests/lms-engine.test.ts",
    "test:player": "tsx --test tests/player-xapi.test.ts frontend/src/player/render-player.test.ts",
    "test:gami": "tsx --test tests/gamification-badges.test.ts",
    "test:cert": "tsx --test tests/certificate-generator.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "jose": "^6.2.4",
    "pdfkit": "^0.19.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.30",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.10.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
