# Copy to .env.local for development. Never commit secrets.

VITE_ENVIRONMENT=local
VITE_API_BASE_URL=

# auth: cognito | dev  (dev forbidden when VITE_ENVIRONMENT=prod)
VITE_AUTH_MODE=dev

# Cognito (required when VITE_AUTH_MODE=cognito)
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5178/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5178/

# Dev auth headers (local only)
VITE_DEV_USER_SUB=dev-local-user
VITE_DEV_USER_EMAIL=dev@example.com

# Optional Vite proxy target for /api
VITE_API_PROXY_TARGET=http://127.0.0.1:8008
