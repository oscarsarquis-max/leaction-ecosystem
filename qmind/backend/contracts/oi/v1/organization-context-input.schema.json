{
  "$defs": {
    "EnvelopeMetadata": {
      "additionalProperties": false,
      "description": "Technical transport metadata only — no business facts.",
      "properties": {
        "environment": {
          "anyOf": [
            {
              "enum": [
                "local",
                "test",
                "homolog",
                "prod"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment"
        },
        "producer_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Software version of the producing system (not schema_version).",
          "title": "Producer Version"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional distributed-trace identifier distinct from correlation_id.",
          "title": "Trace Id"
        }
      },
      "title": "EnvelopeMetadata",
      "type": "object"
    },
    "OrganizationContextPayload": {
      "additionalProperties": false,
      "description": "Extensible factual bundle — add optional nested objects in future minors.",
      "properties": {
        "organization": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrganizationFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrganizationProfileFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "OrganizationContextPayload",
      "type": "object"
    },
    "OrganizationFacts": {
      "additionalProperties": false,
      "description": "Minimal factual org identity on the wire (not a Core table dump).",
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional human label from Core; absence is null, not empty string.",
          "title": "Display Name"
        }
      },
      "title": "OrganizationFacts",
      "type": "object"
    },
    "OrganizationProfileFacts": {
      "additionalProperties": false,
      "description": "Contractual view of persistent Organization Profile facts.\n\nOptional fields use null for 'not provided'. Empty string is a deliberate value\nonly where Core's controlled vocabulary allows '' (e.g. unset band).",
      "properties": {
        "business_model": {
          "anyOf": [
            {
              "enum": [
                "",
                "b2b",
                "b2c",
                "b2b2c",
                "services",
                "manufacturing",
                "mixed",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Model"
        },
        "certification_status": {
          "anyOf": [
            {
              "enum": [
                "unknown",
                "none",
                "in_progress",
                "certified",
                "expired",
                "not_applicable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certification Status"
        },
        "employee_range": {
          "anyOf": [
            {
              "enum": [
                "",
                "1-10",
                "11-50",
                "51-200",
                "201-500",
                "501-1000",
                "1000+"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employee Range"
        },
        "industry": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Industry"
        },
        "legal_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Name"
        },
        "quality_structure": {
          "anyOf": [
            {
              "enum": [
                "unknown",
                "none",
                "informal",
                "formal_partial",
                "formal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Structure"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "trade_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trade Name"
        },
        "unit_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Count"
        }
      },
      "title": "OrganizationProfileFacts",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Logical origin of a message — not a file/module path.",
      "properties": {
        "component": {
          "examples": [
            "organization-context",
            "insight-producer"
          ],
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "system": {
          "examples": [
            "qmind-core",
            "qmind-oi"
          ],
          "minLength": 1,
          "title": "System",
          "type": "string"
        }
      },
      "required": [
        "system",
        "component"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Root envelope: Core → OI.",
  "properties": {
    "context": {
      "$ref": "#/$defs/OrganizationContextPayload"
    },
    "core_organization_id": {
      "description": "Opaque Core Organization.id (UUID). OI must not reinterpret or replace with its own organization registry.",
      "format": "uuid",
      "title": "Core Organization Id",
      "type": "string"
    },
    "correlation_id": {
      "description": "Journey/flow id across multiple Core↔OI calls.",
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional. Only meaningful for future persistent OI side-effects. Not required on read-only interpretation calls. Distinct from request_id.",
      "title": "Idempotency Key"
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvelopeMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "occurred_at": {
      "description": "When the context snapshot was taken at Core (ISO-8601, timezone-aware, prefer UTC).",
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "request_id": {
      "description": "Id of this call instance (observability). Not a business idempotency key.",
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "description": "Contract schema version (independent of product version).",
      "examples": [
        "1.0"
      ],
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    }
  },
  "required": [
    "schema_version",
    "core_organization_id",
    "request_id",
    "correlation_id",
    "occurred_at",
    "source"
  ],
  "title": "OrganizationContextInput",
  "type": "object"
}
