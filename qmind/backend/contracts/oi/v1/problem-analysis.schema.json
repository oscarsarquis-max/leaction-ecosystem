{
  "$defs": {
    "ProblemFinding": {
      "additionalProperties": false,
      "properties": {
        "business_impact": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Business Impact",
          "type": "string"
        },
        "code": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "iso_basis": {
          "items": {
            "enum": [
              "4.1",
              "4.4"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Iso Basis",
          "type": "array"
        },
        "missing_information": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "recommended_next_step": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Recommended Next Step",
          "type": "string"
        },
        "relationship_to_problem": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Relationship To Problem",
          "type": "string"
        },
        "requires_human_validation": {
          "default": true,
          "title": "Requires Human Validation",
          "type": "boolean"
        },
        "supporting_facts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Supporting Facts",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "code",
        "title",
        "description",
        "relationship_to_problem",
        "business_impact",
        "iso_basis",
        "recommended_next_step"
      ],
      "title": "ProblemFinding",
      "type": "object"
    },
    "ProblemHypothesis": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "iso_basis": {
          "items": {
            "enum": [
              "4.1",
              "4.4"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Iso Basis",
          "type": "array"
        },
        "missing_information": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "support_status": {
          "enum": [
            "requires_validation",
            "partially_supported",
            "supported_by_available_facts"
          ],
          "title": "Support Status",
          "type": "string"
        },
        "supporting_facts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Supporting Facts",
          "type": "array"
        }
      },
      "required": [
        "code",
        "statement",
        "rationale",
        "support_status",
        "iso_basis"
      ],
      "title": "ProblemHypothesis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Root envelope: OI → Core for ImprovementCase problem analysis.",
  "properties": {
    "analysis_id": {
      "description": "Opaque analysis id generated by OI for this response.",
      "format": "uuid",
      "title": "Analysis Id",
      "type": "string"
    },
    "context_status": {
      "enum": [
        "insufficient_context",
        "ready_for_initial_analysis"
      ],
      "title": "Context Status",
      "type": "string"
    },
    "core_organization_id": {
      "format": "uuid",
      "title": "Core Organization Id",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ProblemFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/ProblemHypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "improvement_case_id": {
      "format": "uuid",
      "title": "Improvement Case Id",
      "type": "string"
    },
    "interpretation_summary": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Interpretation Summary",
      "type": "string"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "description": "ProblemAnalysis contract schema version.",
      "examples": [
        "1.0"
      ],
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "core_organization_id",
    "improvement_case_id",
    "analysis_id",
    "request_id",
    "correlation_id",
    "generated_at",
    "context_status",
    "interpretation_summary"
  ],
  "title": "ProblemAnalysis",
  "type": "object"
}
