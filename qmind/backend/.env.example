# Logical database: qmind_dev
# Cluster/service: leaction_db (host port typically 5433)
# Copy to .env (never commit .env)

ENVIRONMENT=local
# AUTH_MODE=dev is FORBIDDEN when ENVIRONMENT=prod (app refuses to start)
AUTH_MODE=dev

# Migrator / bootstrap (table owner). Not used for tenant request paths.
DATABASE_URL=postgresql+psycopg://ADMIN_USER:ADMIN_PASSWORD@localhost:5433/qmind_dev
DATABASE_URL_ADMIN=postgresql+psycopg://ADMIN_USER:ADMIN_PASSWORD@localhost:5433/qmind_dev

# Application role: no table ownership, no BYPASSRLS (FORCE RLS applies)
DATABASE_URL_APP=postgresql+psycopg://qmind_app:APP_PASSWORD@localhost:5433/qmind_dev

# Cognito OIDC (required when AUTH_MODE=cognito)
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Object storage (ADR-007) — private dedicated bucket in us-east-2
# STORAGE_BACKEND=memory for local/tests; s3 required when ENVIRONMENT=prod
STORAGE_BACKEND=memory
S3_REGION=us-east-2
S3_BUCKET=qmind-evidences
# Optional LocalStack / MinIO
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EVIDENCE_MAX_BYTES=25000000
EVIDENCE_UPLOAD_EXPIRES_SECONDS=900
EVIDENCE_DOWNLOAD_EXPIRES_SECONDS=300
EVIDENCE_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# security_pass without malware worker — MUST be false in prod
ALLOW_SIMULATED_SECURITY_PASS=true
