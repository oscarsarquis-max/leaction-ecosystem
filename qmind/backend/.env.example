# Logical database: qmind
# Cluster/service: leaction_db (host port typically 5433)
# Copy to .env (never commit .env)

ENVIRONMENT=local
# AUTH_MODE=dev is FORBIDDEN when ENVIRONMENT=prod (app refuses to start)
AUTH_MODE=dev

# Migrator / bootstrap (table owner). Not used for tenant request paths.
DATABASE_URL=postgresql+psycopg://ADMIN_USER:ADMIN_PASSWORD@localhost:5433/qmind
DATABASE_URL_ADMIN=postgresql+psycopg://ADMIN_USER:ADMIN_PASSWORD@localhost:5433/qmind

# Application role: no table ownership, no BYPASSRLS (FORCE RLS applies)
DATABASE_URL_APP=postgresql+psycopg://qmind_app:APP_PASSWORD@localhost:5433/qmind

# Cognito OIDC (required when AUTH_MODE=cognito)
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
