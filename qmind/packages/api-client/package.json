{
  "name": "@qmind/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated TypeScript client for QMind OpenAPI (openapi-v1-initial)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "openapi-ts.config.ts"
  ],
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "check:drift": "node ./scripts/check-drift.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test src/client.test.ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.73.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {},
  "peerDependencies": {},
  "license": "UNLICENSED"
}
