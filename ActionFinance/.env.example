# Copie para .env na raiz do ActionFinance. Não versionar .env.
# Placeholders apenas — o setup local gera segredos em .local/

ACTIONFINANCE_POSTGRES_PORT=5439
ACTIONFINANCE_BACKEND_PORT=8091
ACTIONFINANCE_FRONTEND_PORT=5179
ACTIONFINANCE_FRONTEND_ORIGIN=http://127.0.0.1:5179,http://localhost:5179

ACTIONFINANCE_BOOTSTRAP_PASSWORD=replace-with-generated-secret
ACTIONFINANCE_MIGRATOR_PASSWORD=replace-with-generated-secret
ACTIONFINANCE_RUNTIME_PASSWORD=replace-with-generated-secret

SPRING_PROFILES_ACTIVE=local-demo
ACTIONFINANCE_DEMO_AUTH_ENABLED=true
# Tokens demo: arquivo ignorado .local/demo-tokens.env (gerado pelo setup)
