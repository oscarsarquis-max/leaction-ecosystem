# Copiar para um secret store. Sem valores reais neste arquivo.

# Banco
ACTIONFINANCE_DATASOURCE_URL=jdbc:postgresql://actionfinance-postgres:5432/actionfinance
ACTIONFINANCE_RUNTIME_USERNAME=actionfinance_runtime
ACTIONFINANCE_RUNTIME_PASSWORD=
ACTIONFINANCE_MIGRATOR_USERNAME=actionfinance_migrator
ACTIONFINANCE_MIGRATOR_PASSWORD=
# Web task: false. One-off migrate task: true. Missing migrator on the web task is intentional.
ACTIONFINANCE_FLYWAY_ENABLED=false
ACTIONFINANCE_READINESS_INCLUDE=readinessState,db

# Origem pública (mesma origem UI+API)
ACTIONFINANCE_PUBLIC_ORIGIN=https://actionfinance.actionhub.com.br
ACTIONFINANCE_BIND_ADDRESS=0.0.0.0
ACTIONFINANCE_BACKEND_PORT=8091

# OIDC Authorization Code — URI de retorno explícita, sem derivar de Host
ACTIONFINANCE_OIDC_ENABLED=true
ACTIONFINANCE_OIDC_ISSUER=
ACTIONFINANCE_OIDC_CLIENT_ID=
ACTIONFINANCE_OIDC_CLIENT_SECRET=
ACTIONFINANCE_OIDC_REDIRECT_URI=https://actionfinance.actionhub.com.br/login/oauth2/code/actionfinance

# Sessão
ACTIONFINANCE_SESSION_TIMEOUT_MINUTES=30
ACTIONFINANCE_SESSION_COOKIE_SECURE=true

# Ingress: do not trust client-supplied forwarded headers. The process is not the public edge.
ACTIONFINANCE_TRUST_FORWARDED_HEADERS=false
ACTIONFINANCE_FORWARD_HEADERS_STRATEGY=none
SERVER_FORWARD_HEADERS_STRATEGY=none

# PRM_009 receipt sync — homolog stays false in production
ACTIONFINANCE_INTEGRATION_HOMOLOG=false
ACTIONFINANCE_RECEIPT_SYNC_ENABLED=false
ACTIONFINANCE_DEMO_AUTH_ENABLED=false
ACTIONFINANCE_SPIDER_BASE_URL=
ACTIONFINANCE_SPIDER_SECRET=
ACTIONFINANCE_SPIDER_MONITOR_BASE_URL=
